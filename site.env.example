# 서버별 설정. 이 파일을 site.env 로 복사한 뒤 필요한 줄만 고친다:  cp site.env.example site.env
# scripts/env.sh 가 읽는다. site.env 는 git 에 올라가지 않는다.

export HOST_LABEL=company-server         # 결과 폴더 이름: results/<HOST_LABEL>/
export KIND_CLUSTER_NAME=asb             # 이 작업 전용 kind 클러스터 이름. 서버의 다른 kind 클러스터와 겹치지 않게 한다
export KUBECONFIG="$ROOT/kubeconfig"     # 이 작업 전용 kubeconfig. ~/.kube/config 를 건드리지 않고, 다른 클러스터에 잘못 배포하는 것을 막는다

# 포트가 이미 쓰이고 있을 때만 바꾼다 (scripts/00_preflight.sh 출력의 'port in use' 줄)
# export PORT=8000                       # scripts/04_counter_cycle.sh 가 쓰는 로컬 포트
# export LOCUST_PORT=8089                # scripts/06_run_load.sh 가 쓰는 로컬 포트

# 규모
# export WORKER_COUNT=4                  # worker pod 수
# export ASB_STAGES="S T A B C D E F"    # 돌릴 단계. S = substrate 기본 제공 시나리오, T 이하 = 이 저장소가 정한 조건. 일부만 하려면 줄인다 (예: "S T A")

# 정해진 단계 밖의 실행을 추가하려면 X 단계로 넣는다 (scripts/stage.sh plan 으로 확인).
# 형식: 단계|실행이름|배포(smoke 또는 big. 그 밖의 이름은 scripts/stage.sh 의 spec 참고)|업로드 한도(default 또는 2Gi)|세션 수|실행 시간(초)|추가 인자
# export ASB_STAGES="S T A B C D E F X"
# export ASB_EXTRA_PLAN="
# X|X_turn200|smoke|default|200|600|lifecycle_mode=sync agentsession_awake=50 target_rps=10
# "
